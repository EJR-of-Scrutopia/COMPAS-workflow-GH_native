scripts/rhino_environment.txt
scripts/rhino_smoke_fd.txt

# Study results are build products; the problem file is the source.
studies/**/results/

# CRA runs on its own Python 3.10 interpreter; see scripts/setup_cra_env.sh
.venv-cra/
demo/*.png
!demo/pavilion-result.json
