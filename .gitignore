# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example

# Python build and package artifacts
build/
dist/
*.egg-info/
*.whl

# Rhino, Grasshopper, Script Editor, and Yak build artifacts
*.gha
*.rhp
*.rui
*.yak
*.gh~
*.ghx~
*.3dmbak
plugin/bin/
plugin/obj/
plugin/**/bin/
plugin/**/obj/
plugin/build/
plugin/generated/
tests/**/bin/
tests/**/obj/

# Editors and operating systems
.idea/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db

# Local logs and scratch files
*.log
*.tmp
*.bak
scratch/

# Generated Rhino environment/smoke-test reports
scripts/rhino_environment.txt
scripts/rhino_smoke_fd.txt

# Study results are build products; the problem file is the source.
bench/studies/**/results/

# CRA runs on its own Python 3.10 interpreter; see scripts/setup_cra_env.sh
.venv-cra/
.venv-fea/
bench/demo/*.png
!bench/demo/pavilion-result.json

# Generated studio outputs
bench/studies/*/studio/
bench/studio/hdri/

# Upstream COMPAS example repos, fetched by scripts/fetch_compas_examples.sh
upstream/

# The probe rig's node install: bench/scripts/studio_probe.mjs needs
# puppeteer-core, installed locally next to it rather than pinned in the repo.
bench/scripts/probe-env/

# The prop library is a BUILD PRODUCT of tools/props/fetch.mjs. Photoscanned
# models run to megabytes apiece and the script can fetch and rebuild them
# from Poly Haven at any time, so the models stay out and the manifest that
# describes them, which is small and is what the studio reads, stays in.
bench/studio/props-hd/*.glb
tools/props/node_modules/
tools/props/.work/
tools/props/probe*.mjs
tools/props/package-lock.json

# The studio's remembered folders. They name paths on one machine.
bench/studio/settings.json
bench/studio/props-hd/*.thumb.png
